{
	"name": "poocommerce-monorepo",
	"title": "PooCommerce Monorepo",
	"description": "Monorepo for the PooCommerce ecosystem",
	"homepage": "https://poocommerce.com/",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": "^24.15.0"
	},
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/poocommerce/poocommerce.git"
	},
	"author": "Automattic",
	"license": "GPL-2.0-or-later",
	"bugs": {
		"url": "https://github.com/poocommerce/poocommerce/issues"
	},
	"scripts": {
		"build": "pnpm -r --workspace-concurrency=Infinity --stream '/^build:project:.*$/'",
		"test": "pnpm -r test",
		"lint": "pnpm -r lint",
		"cherry-pick": "node ./tools/cherry-pick/bin/run",
		"clean": "rimraf -g '**/node_modules' 'packages/*/*/vendor' 'plugins/*/vendor' && pnpm store prune",
		"clean:build": "rimraf -g '**/node_modules/.cache' '**/*.tsbuildinfo' 'packages/js/*/build' 'packages/js/*/build-*' 'packages/js/*/dist' 'plugins/*/build' 'plugins/poocommerce/client/*/build' && git clean --force -d -X --quiet ./plugins/poocommerce/assets",
		"preinstall": "npx only-allow pnpm",
		"postinstall": "husky",
		"run-canonical-extensions-tests": "bash bin/run-canonical-extensions-tests.sh",
		"sync-dependencies": "pnpm exec syncpack fix",
		"utils": "./tools/monorepo-utils/bin/run",
		"wc:build": "pnpm --filter='@poocommerce/plugin-poocommerce' build",
		"wc:build:admin": "pnpm --filter='@poocommerce/plugin-poocommerce' build:admin",
		"wc:build:blocks": "pnpm --filter='@poocommerce/plugin-poocommerce' build:blocks",
		"wc:build:classic-assets": "pnpm --filter='@poocommerce/plugin-poocommerce' build:classic-assets",
		"wc:env": "pnpm --filter='@poocommerce/plugin-poocommerce' env:dev",
		"wc:env:restart": "pnpm --filter='@poocommerce/plugin-poocommerce' env:restart",
		"wc:env:stop": "pnpm --filter='@poocommerce/plugin-poocommerce' env:stop",
		"wc:watch": "pnpm --filter='@poocommerce/plugin-poocommerce' watch:build",
		"wc:watch:admin": "pnpm --filter='@poocommerce/plugin-poocommerce' watch:build:admin",
		"wc:watch:blocks": "pnpm --filter='@poocommerce/plugin-poocommerce' watch:build:blocks",
		"wc:watch:classic-assets": "pnpm --filter='@poocommerce/plugin-poocommerce' watch:build:classic-assets"
	},
	"devDependencies": {
		"@babel/preset-env": "catalog:tooling",
		"@babel/runtime": "catalog:tooling",
		"@types/node": "^24.1.0",
		"@poocommerce/eslint-config": "workspace:*",
		"@poocommerce/eslint-plugin": "workspace:*",
		"@poocommerce/monorepo-utils": "workspace:*",
		"@wordpress/prettier-config": "4.49.0",
		"babel-loader": "9.2.x",
		"chalk": "^4.1.2",
		"copy-webpack-plugin": "13.0.x",
		"core-js": "^3.34.0",
		"css-loader": "6.11.x",
		"glob": "^10.3.10",
		"husky": "^9.0.11",
		"jest": "29.5.x",
		"lint-staged": "^12.5.0",
		"mkdirp": "^1.0.4",
		"moment": "^2.29.4",
		"node-stream-zip": "^1.15.0",
		"postcss-loader": "4.3.x",
		"prettier": "npm:wp-prettier@3.0.3",
		"regenerator-runtime": "^0.13.11",
		"request": "^2.88.2",
		"rimraf": "5.0.5",
		"sass": "^1.69.5",
		"sass-loader": "10.5.x",
		"syncpack": "15.3.3",
		"typescript": "5.7.x",
		"webpack": "catalog:tooling"
	},
	"dependencies": {
		"@babel/core": "catalog:tooling",
		"@wordpress/babel-preset-default": "next",
		"lodash": "^4.18.1",
		"wp-textdomain": "1.0.1"
	},
	"pnpm": {
		"packageExtensions": {
			"@wordpress/dataviews@10.1.7": {
				"dependencies": {
					"uuid": "^9.0.1"
				}
			}
		},
		"overrides": {
			"@types/react": "18.3.x",
			"@wordpress/data-controls>@wordpress/api-fetch": "catalog:wp-min",
			"@wordpress/private-apis": "catalog:wp-min",
			"react-resize-aware": "3.1.1",
			"sass": "1.69.5"
		},
		"patchedDependencies": {
			"@wordpress/edit-site@5.15.0": "bin/patches/@wordpress__edit-site@5.15.0.patch",
			"@wordpress/e2e-test-utils-playwright@1.33.2": "bin/patches/@wordpress__e2e-test-utils-playwright@1.33.2.patch"
		}
	}
}

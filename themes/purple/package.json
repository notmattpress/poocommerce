{
	"name": "@poocommerce/theme-purple",
	"version": "1.0.3",
	"description": "Purple, a PooCommerce block theme.",
	"private": true,
	"license": "GPL-2.0-or-later",
	"engines": {
		"node": "^24.15.0"
	},
	"files": [
		"assets",
		"inc",
		"parts",
		"patterns",
		"styles",
		"templates",
		"*.php",
		"style.css",
		"theme.json",
		"screenshot.*",
		"readme.txt",
		"LICENSE*"
	],
	"scripts": {
		"validate": "pnpm --filter=@poocommerce/theme-cli validate purple",
		"changelog": "composer exec -- changelogger",
		"env:start": "pnpm --filter=@poocommerce/theme-cli wp-env start purple",
		"env:stop": "pnpm --filter=@poocommerce/theme-cli wp-env stop purple",
		"build": "pnpm --filter=@poocommerce/theme-cli build purple"
	},
	"devDependencies": {
		"@poocommerce/theme-cli": "workspace:*"
	},
	"config": {
		"ci": {
			"lint": {
				"command": "validate",
				"changes": "**/*",
				"events": [
					"pull_request"
				]
			}
		}
	}
}
